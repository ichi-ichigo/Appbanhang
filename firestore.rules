rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GIO HANG (cart) - BAO MAT CAO:
    // Chi user dang dang nhap moi duoc xem va sua gio hang cua chinh ho.
    match /cart/{userId}/items/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. NGUOI DUNG (users) - BAO MAT VUA:
    // App: Chi user tu sua thong tin cua minh.
    // Admin: Mo quyen read de trang Admin thong ke danh sach khach hang.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if true;
    }

    // 3. DON HANG (orders):
    // App: Bat buoc dang nhap moi duoc dat hang.
    // Admin: Tam mo read/update/delete de web Admin duyet don.
    match /orders/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if true;
    }

    // Fallback neu collection bi tao nham ten "oders".
    match /oders/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if true;
    }

    // 4. SAN PHAM (products):
    // App: Ai cung xem duoc san pham.
    // Admin: Mo write de them/sua/xoa san pham tu trang web.
    match /products/{document=**} {
      allow read, write: if true;
    }

    // 5. VOUCHER (vouchers):
    // Admin: Mo read/write de tao/sua/xoa voucher tu web-admin.
    // Collection se tu xuat hien khi web-admin ghi document dau tien.
    match /vouchers/{document=**} {
      allow read, write: if true;
    }

    // 6. QUANG CAO (banners):
    // Bat ky ai cung xem duoc anh bia quang cao tren trang chu App.
    match /banners/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
