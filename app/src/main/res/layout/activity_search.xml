<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_icon_style"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/edittext_style"
            android:hint="Tim kiem giay, thuong hieu..."
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/brand_filter_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_result_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="San pham phu hop"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_price_sort"
                android:layout_width="132dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_search_products"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/search_pagination"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_search_prev_page"
                android:layout_width="92dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@null"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Truoc"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/txt_search_page_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Trang 1/1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_search_next_page"
                android:layout_width="92dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@null"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Sau"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:backgroundTint="@null" />

        </LinearLayout>

        <TextView
            android:id="@+id/txt_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Khong tim thay san pham"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
